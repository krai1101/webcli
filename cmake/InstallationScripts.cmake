if(WIN32)
  set(WEBCLI_INSTALL_EXTENSION ps1)
else()
  set(WEBCLI_INSTALL_EXTENSION sh)
endif()
foreach(KIND INSTALL MAINTENANCE)
  if(KIND STREQUAL "INSTALL")
    set(SCRIPT "${PROJECT_SOURCE_DIR}/scripts/install.${WEBCLI_INSTALL_EXTENSION}")
  else()
    set(SCRIPT "${PROJECT_SOURCE_DIR}/scripts/manage.${WEBCLI_INSTALL_EXTENSION}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SCRIPT}")
  file(READ "${SCRIPT}" SCRIPT_BYTES HEX)
  string(REGEX REPLACE "(..)" "0x\\1," WEBCLI_${KIND}_BYTES "${SCRIPT_BYTES}")
endforeach()
configure_file("${PROJECT_SOURCE_DIR}/src/cli/installation_scripts.hpp.in"
  "${PROJECT_BINARY_DIR}/generated/cli/installation_scripts.hpp" @ONLY)
